<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local folder feed for RtkSharp.TreeSitter.Trimmed — a size-trimmed redistribution of
      TreeSitter.DotNet (see third-party/treesitter-dotnet-trimmed/). Regenerate with
      third-party/treesitter-dotnet-trimmed/build-trimmed-package.ps1 if this ever needs
      to track a new upstream TreeSitter.DotNet version or a new registered grammar.
    -->
    <add key="rtksharp-local" value="third-party/treesitter-dotnet-trimmed/local-feed" />
  </packageSources>
</configuration>
