<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rtk</ToolCommandName>
    <PackageId>RtkSharp</PackageId>
    <AssemblyName>RtkSharp</AssemblyName>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!--
      SQLite provider for the Phase 5 tracking database (RtkSharp/Core/Tracking/Tracker.cs), porting
      Rust's `rusqlite` (src/core/tracking.rs). Version 10.0.9 is the latest stable release as of this
      writing and is confirmed AOT/trim-compatible (PublishAot=true): it is a thin ADO.NET wrapper
      over SQLitePCLRaw's native e_sqlite3 binary via P/Invoke, not reflection-based ORM mapping, so
      Native AOT trimming does not touch its query/marshalling path. Verified with a real
      `dotnet publish -c Release -r win-x64` smoke test that opens a file-backed DB, creates the
      Tracker schema, and round-trips a row through the published native executable (not just that
      the build succeeds) — see Task 1's report for the exact run.
      Explicitly pins the transitive SQLitePCLRaw.bundle_e_sqlite3 dependency to 3.0.3 (newer than the
      2.1.11 Microsoft.Data.Sqlite 10.0.9 would otherwise resolve) because 2.1.11 trips NU1903 (a
      known high-severity advisory, GHSA-2m69-gcr7-jv3q, in the bundled native e_sqlite3 library);
      3.0.3 resolves cleanly against Microsoft.Data.Sqlite 10.0.9 with no restore warnings.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Spectre.Console" Version="0.57.1" />
    <!--
      TOML parser/serializer for config.toml (RtkSharp/Core/Config.cs) and, in later Phase 4 tasks,
      the .rtk/filters.toml TOML filter DSL. No TOML support exists in the .NET BCL. Version 2.10.1
      is the latest stable release as of this writing; it ships an STJ-style TomlSerializer with an
      AOT-safe source-generation mode (TomlSerializerContext + [TomlSerializable]), which Config.cs
      uses for Config.Load() so PublishAot=true does not depend on reflection. Its built-in pretty
      printer does not reproduce Rust's `toml::to_string_pretty` shape (it writes arrays inline with
      no line wrapping and omits the blank line Rust inserts between top-level tables), so
      Config.cs's Save()/ShowConfig() write TOML via a small hand-rolled formatter targeting exactly
      Config's fixed 6-section shape instead of Tomlyn's generic serializer; see Config.cs's remarks
      for the verified oracle comparison.
    -->
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <!--
      Roslyn's C# syntax-tree API, powering RtkSharp/Ast/CSharpAstAnalyzer.cs — the reference
      implementation of the new, RtkSharp-only "rtk read, level=ast" tier (no Rust counterpart;
      this is a deliberate extension beyond the ported spec, disclosed in
      docs/parity/compatibility-ledger.md). Only the syntax layer (CSharpSyntaxTree.ParseText) is
      used, not a full Compilation/semantic model — no project references or metadata are needed,
      keeping this to a pure text-in/text-out transform. CONFIRMED compatible with this project's
      PublishAot=true via a real `dotnet publish -c Release -r win-x64 -p:PublishAot=true` smoke
      test whose published executable was actually run end-to-end (not just a successful build);
      see CSharpAstAnalyzer.cs's class remarks for the measured size/startup cost.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!--
      .NET bindings for the native tree-sitter parsing library (mariusgreuel/tree-sitter-dotnet-bindings),
      the AST analyzer backend for every "rtk read, level=ast" language other than C#
      (Rust/Python/TypeScript/Go/C/Cpp/Java/Ruby/Shell; JavaScript uses Acornima instead — see its
      own package comment). A thin P/Invoke layer over the native tree-sitter core plus one native
      grammar DLL per language (copied next to the published executable via the package's build
      targets). CONFIRMED compatible with this project's PublishAot=true via a real
      `dotnet publish -c Release -r win-x64 -p:PublishAot=true` smoke test: the published
      executable actually parsed real Rust source and produced a correct syntax tree — the package
      author does not document AOT testing, so this was verified directly rather than assumed from
      a successful build.

      Uses RtkSharp.TreeSitter.Trimmed instead of the upstream TreeSitter.DotNet package: upstream
      bundles 28+ native grammars per RID (~68MB for win-x64 alone) but RtkSharp's
      AstAnalyzerRegistry only ever loads 9 of them, so a size-trimmed redistribution (MIT,
      repackaged from the same upstream binaries — see third-party/treesitter-dotnet-trimmed/)
      keeps only those 9 grammars, cutting the native payload by ~90%. Same managed assembly/API,
      just fewer bundled .dll/.so/.dylib files.
    -->
    <PackageReference Include="RtkSharp.TreeSitter.Trimmed" Version="1.3.0-rtksharp.1" />
    <!--
      Pure-managed JavaScript parser (adams85/acornima, a maintained fork of Esprima.NET/acornjs,
      also used internally by Jint) producing a real ESTree AST — the AST analyzer backend for
      JavaScript specifically, preferred over TreeSitter.DotNet's tree-sitter-javascript grammar
      for this one language because it ships no native assets at all (pure C#, no P/Invoke),
      which is a strictly better Native-AOT story than a native binding. Does NOT parse
      TypeScript's type syntax — TypeScript still uses TreeSitter.DotNet's tree-sitter-typescript
      grammar (see that package's comment above).
    -->
    <PackageReference Include="Acornima" Version="1.6.2" />
    <InternalsVisibleTo Include="RtkSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RtkSharp.Filters\RtkSharp.Filters.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embeds the exact bytes of the Rust oracle's `include_str!("../../hooks/claude/rtk-awareness.md")`
      source file (src/hooks/init.rs RTK_SLIM constant). Loaded verbatim (no line-ending
      normalization) via GetManifestResourceStream so both builds pick up whatever CRLF/LF the
      current git checkout produced for this un-gitattributes-protected file, keeping the two
      binaries byte-exact on any given machine/checkout.
    -->
    <EmbeddedResource Include="../hooks/claude/rtk-awareness.md">
      <LogicalName>RtkSharp.Hooks.rtk-awareness.md</LogicalName>
    </EmbeddedResource>
    <!--
      Embeds the exact bytes of the Rust oracle's `include_str!("../../hooks/codex/rtk-awareness.md")`
      source file (src/hooks/init.rs RTK_SLIM_CODEX constant), the same way as the Claude Code
      template above.
    -->
    <EmbeddedResource Include="../hooks/codex/rtk-awareness.md">
      <LogicalName>RtkSharp.Hooks.rtk-awareness-codex.md</LogicalName>
    </EmbeddedResource>
    <!--
      Embeds all 63 built-in TOML filter definitions (src/filters/*.toml) byte-for-byte, one
      embedded resource per file. Mirrors Rust's build.rs, which concatenates the same directory's
      *.toml files (sorted alphabetically by file name) into a single builtin_filters.toml blob at
      compile time via include_str!. RtkSharp.Filters.TomlFilterBuiltins.LoadConcatenated() performs
      the equivalent concatenation at load time instead (sorting these resource names, which embed
      the original file name via %(Filename)%(Extension)), so both builds parse the same 63 files as
      one TOML document rather than as 63 independent ones — this matters because Rust's
      cross-file behavior (e.g. a duplicate match_command key colliding across files) only manifests
      under a single parse pass.
    -->
    <EmbeddedResource Include="../src/filters/*.toml">
      <LogicalName>RtkSharp.Filters.Builtin.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!--
      Embeds the exact bytes of the Rust oracle's `include_str!("../../hooks/pi/rtk.ts")` source
      file (src/hooks/init.rs PI_PLUGIN constant), the same byte-exact pattern as the awareness
      docs above.
    -->
    <EmbeddedResource Include="../hooks/pi/rtk.ts">
      <LogicalName>RtkSharp.Hooks.pi-rtk.ts</LogicalName>
    </EmbeddedResource>
    <!--
      Embeds the exact bytes of the Rust oracle's `include_str!("../../hooks/opencode/rtk.ts")`
      source file (src/hooks/init.rs OPENCODE_PLUGIN constant).
    -->
    <EmbeddedResource Include="../hooks/opencode/rtk.ts">
      <LogicalName>RtkSharp.Hooks.opencode-rtk.ts</LogicalName>
    </EmbeddedResource>
    <!--
      Embeds the exact bytes of the Rust oracle's `include_str!("../../hooks/hermes/rtk-rewrite/__init__.py")`
      and `include_str!("../../hooks/hermes/rtk-rewrite/plugin.yaml")` source files (src/hooks/init.rs
      HERMES_PLUGIN_INIT/HERMES_PLUGIN_YAML constants), the same way as the Claude Code/Codex
      rtk-awareness.md templates above: loaded verbatim (no line-ending normalization) so both builds
      pick up whatever CRLF/LF the current git checkout produced for these un-gitattributes-protected
      files.
    -->
    <EmbeddedResource Include="../hooks/hermes/rtk-rewrite/__init__.py">
      <LogicalName>RtkSharp.Hooks.hermes-rtk-rewrite-init.py</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../hooks/hermes/rtk-rewrite/plugin.yaml">
      <LogicalName>RtkSharp.Hooks.hermes-rtk-rewrite-plugin.yaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
